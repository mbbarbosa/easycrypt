(* ******** Defining the signature scheme (generic FS signature) ************* *)
module (IDS_Sig (P: Prover, V:Verifier) : Scheme_RO) (O:QRO) : Scheme = {
  proc keygen() : PK*SK = {
    var sk, pk;
    (pk,sk) <@ P.keygen();
    return (pk,sk);
  }
  proc sign(sk:SK,m:M) : Sig = {
    var w,c,z;

    w <@ P.commit(sk);
    c <@ O.hc ((w,m));
    z <@ P.response(sk,c);
    return (w,z);
  }
  proc verify(pk:PK, m:M, s:Sig):bool = {
    var result,c,w,z;
    (w,z) <- s;
    c <@ O.hc((w,m));
    result <@ V.verify(pk,w,c,z);
    return result; 
  }
}.

